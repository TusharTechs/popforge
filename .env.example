# Local broadcaster companion. Register this redirect in your Twitch app.
PORT=4317
APP_ORIGIN=http://localhost:4317
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4317/auth/twitch/callback
# Optional: enables actual Codex SDK scene generation using your configured Codex login.
# Recipe remix works without a key or login. Enabling this may consume your Codex usage.
ENABLE_CODEX=false
# Optional SDK model override; leave blank for the Codex account default.
CODEX_MODEL=

# Optional executable override; otherwise use the Codex CLI on PATH, then the SDK bundle.
CODEX_CLI_PATH=
